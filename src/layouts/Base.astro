---
/**
 * Site shell — header, footer, and global styles.
 *
 * BRANDING IS PLACEHOLDER. The program name and colors are deliberately
 * parked in CSS custom properties and the `SITE_NAME` constant below, because
 * three different names were in use on the old site ("UNLV School of Music
 * Division of Jazz Studies", "Division of Jazz and Commercial Music", and
 * "Jazz & Commercial Music Area") and Dave has not picked one yet.
 *
 * When he does: change SITE_NAME here, swap --accent, and drop the real logo
 * from the J&CM Logos folder in the shared Drive into public/. Nothing else
 * needs touching.
 */

import { SEARCH_ENGINES_ALLOWED } from '../site';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const SITE_NAME = 'UNLV Jazz & Commercial Music';
const pageTitle = title ? `${title} — ${SITE_NAME}` : SITE_NAME;

// Only pages that actually exist. Add to this as pages ship — never link ahead
// of the build, since a nav pointing at a 404 is worse than a shorter nav.
const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/events', label: 'Events' },
  { href: '/ensembles', label: 'Ensembles' },
  { href: '/faculty', label: 'Faculty' },
  { href: '/media', label: 'Media' },
];

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    {
      /* Keeps an unfinished site out of search results. Flip the switch in
         src/site.ts at launch. */
      !SEARCH_ENGINES_ALLOWED && <meta name="robots" content="noindex, nofollow" />
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="site-header">
      <div class="wrap header-inner">
        <a class="wordmark" href="/">{SITE_NAME}</a>
        <nav aria-label="Main">
          <ul>
            {
              navLinks.map((link) => (
                <li>
                  <a
                    href={link.href}
                    aria-current={currentPath === link.href ? 'page' : undefined}
                  >
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <p>
          <a href="mailto:jazz@unlv.edu">jazz@unlv.edu</a>
        </p>
        <p class="disclaimer">
          Maintained by the UNLV Jazz &amp; Commercial Music area. Not an
          official University of Nevada, Las Vegas website.
        </p>
      </div>
    </footer>

    <style is:global>
      :root {
        --accent: #b10202;
        --ink: #16161a;
        --ink-soft: #55555f;
        --rule: #e2e2e6;
        --page: #ffffff;
        --panel: #f7f7f8;
        --measure: 68rem;
      }

      *,
      *::before,
      *::after {
        box-sizing: border-box;
      }

      html {
        -webkit-text-size-adjust: 100%;
      }

      body {
        margin: 0;
        background: var(--page);
        color: var(--ink);
        font: 16px/1.6 system-ui, -apple-system, "Segoe UI", Helvetica, Arial, sans-serif;
        display: flex;
        min-height: 100vh;
        flex-direction: column;
      }

      .wrap {
        width: 100%;
        max-width: var(--measure);
        margin-inline: auto;
        padding-inline: 1.25rem;
      }

      main {
        flex: 1;
        padding-block: 2.5rem 4rem;
      }

      a {
        color: var(--accent);
      }

      h1,
      h2,
      h3 {
        line-height: 1.2;
        text-wrap: balance;
      }

      h1 {
        font-size: clamp(1.9rem, 1.3rem + 2.4vw, 2.75rem);
        margin: 0 0 0.5rem;
      }

      h2 {
        font-size: 1.35rem;
        margin: 2.5rem 0 1rem;
      }

      .skip-link {
        position: absolute;
        left: -9999px;
      }

      .skip-link:focus {
        left: 1rem;
        top: 1rem;
        z-index: 10;
        background: var(--page);
        padding: 0.5rem 0.75rem;
        border: 2px solid var(--accent);
      }

      /* Header */
      .site-header {
        border-bottom: 1px solid var(--rule);
      }

      .header-inner {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem 1.5rem;
        align-items: center;
        justify-content: space-between;
        padding-block: 1rem;
      }

      .wordmark {
        font-weight: 700;
        font-size: 1.05rem;
        letter-spacing: -0.01em;
        color: var(--ink);
        text-decoration: none;
      }

      .site-header nav ul {
        display: flex;
        flex-wrap: wrap;
        gap: 1.25rem;
        margin: 0;
        padding: 0;
        list-style: none;
      }

      .site-header nav a {
        color: var(--ink-soft);
        text-decoration: none;
        font-weight: 500;
      }

      .site-header nav a:hover,
      .site-header nav a[aria-current='page'] {
        color: var(--accent);
      }

      /* Footer */
      .site-footer {
        border-top: 1px solid var(--rule);
        background: var(--panel);
        padding-block: 1.5rem 2rem;
        font-size: 0.9rem;
        color: var(--ink-soft);
      }

      .site-footer p {
        margin: 0.25rem 0;
      }

      .disclaimer {
        font-size: 0.8rem;
      }

      /* Event lists */
      .lede {
        font-size: 1.1rem;
        color: var(--ink-soft);
        margin-top: 0;
        max-width: 44rem;
      }

      .event-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: grid;
        gap: 1px;
        background: var(--rule);
        border: 1px solid var(--rule);
        border-radius: 6px;
        overflow: hidden;
      }

      .event {
        background: var(--page);
        padding: 1.1rem 1.25rem;
        display: grid;
        gap: 0.3rem;
      }

      .event-when {
        font-size: 0.85rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .event-headline {
        font-size: 1.1rem;
        font-weight: 600;
        margin: 0;
      }

      .event-meta {
        margin: 0;
        color: var(--ink-soft);
        font-size: 0.95rem;
      }

      .event-meta a {
        color: inherit;
      }

      .event-note {
        margin: 0.2rem 0 0;
        font-size: 0.95rem;
      }

      .event.is-cancelled .event-headline {
        text-decoration: line-through;
        text-decoration-thickness: 1px;
      }

      .badge {
        display: inline-block;
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 0.15rem 0.45rem;
        border-radius: 3px;
        vertical-align: 0.1em;
        margin-left: 0.4rem;
      }

      .badge-cancelled {
        background: var(--accent);
        color: #fff;
      }

      .badge-tentative {
        background: var(--rule);
        color: var(--ink-soft);
      }

      .empty {
        border: 1px dashed var(--rule);
        border-radius: 6px;
        padding: 2rem 1.25rem;
        text-align: center;
        color: var(--ink-soft);
        background: var(--panel);
      }
    </style>
  </body>
</html>
