---
import Base from '../../layouts/Base.astro';
import { supporters } from '../../data/supporters';

/**
 * All gifts to the program go through the UNLV Foundation. Nothing on this site
 * handles money directly and it never should — UNLV hasn't sanctioned this
 * site, and a donation form on it would be inappropriate regardless.
 *
 * This is the Foundation's unit page rather than a J&CM-designated giving form.
 * It carries no designation field, so a donor arriving there has no obvious way
 * to route a gift to this program — which is why the copy below tells them to
 * specify Jazz & Commercial Music, and offers an email route instead. If a
 * designated fund link exists, use it here instead; it would be better.
 */
const FOUNDATION_URL = 'https://www.unlv.edu/unit/foundation';
---

<Base
  title="Support"
  description="Support jazz and commercial music at UNLV. Gifts fund scholarships, guest artists, and the ensembles' recording and touring, and are made through the UNLV Foundation."
>
  <h1>Support the program</h1>

  <p class="lede">
    Our ensembles perform across Las Vegas, record every year, and travel to
    national festivals. Our students study with working musicians and take home
    DownBeat awards — 53 of them since 2010. None of that happens without people
    who decided this program was worth funding.
  </p>

  <h2>What your support does</h2>

  <ul class="impact">
    <li><strong>Scholarships</strong> that let students study here who otherwise could not.</li>
    <li><strong>Guest artists and clinicians</strong> brought in to work directly with our students.</li>
    <li><strong>Recording projects</strong>, so student work exists past the night it was played.</li>
    <li><strong>Travel</strong> to festivals and competitions that put our ensembles in front of national audiences.</li>
  </ul>

  <h2>How to give</h2>

  <p>
    All gifts to the program are made through the
    <a href={FOUNDATION_URL}>UNLV Foundation</a>.
  </p>

  <p>
    <strong>Please specify Jazz &amp; Commercial Music</strong> when you give, so
    your gift reaches this program rather than the university's general fund. If
    you'd rather talk it through first — or want to direct a gift to a particular
    scholarship or ensemble — email
    <a href="mailto:jazz@unlv.edu">jazz@unlv.edu</a> and we'll connect you with
    the right person at the Foundation.
  </p>

  <h2>Special thanks</h2>

  <p>
    The program's work is made possible by these people and organizations.
  </p>

  <ul class="supporters">
    {
      supporters.map((supporter) => (
        <li>
          {supporter.url ? (
            <a href={supporter.url}>{supporter.name}</a>
          ) : (
            supporter.name
          )}
        </li>
      ))
    }
  </ul>

  <style>
    .impact {
      max-width: 46rem;
      padding-left: 1.2rem;
    }

    .impact li {
      margin-bottom: 0.4rem;
    }

    .supporters {
      list-style: none;
      padding-left: 0;
      max-width: 46rem;
      margin-top: 1rem;
    }

    .supporters li {
      padding: 0.55rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .supporters li:last-child {
      border-bottom: none;
    }
  </style>
</Base>
