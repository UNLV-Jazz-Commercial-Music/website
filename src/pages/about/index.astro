---
/**
 * About.
 *
 * All content comes from the CMS — see src/data/about.ts for the shape and the
 * reasoning. This file is layout only; nothing here needs editing to change the
 * words on the page.
 *
 * Originally written from a 2025 program press announcement, reworded for the
 * web. The source was one unbroken block of prose — the same wall-of-text
 * problem the audit flagged on the old site — so it's sectioned here, with the
 * two very long name lists behind disclosure toggles: available on demand,
 * not dominating the page.
 *
 * NAME SPELLINGS CORRECTED from that press release, all flagged to Jaxon:
 *   Katherine McFee -> Katharine McPhee · Tricia Yearwood -> Trisha Yearwood
 *   Zach Brown -> Zac Brown · Kenny Warner -> Kenny Werner
 *   Lionel Ritchie -> Lionel Richie · Gregg Bissonnette -> Gregg Bissonette
 */
import Base from '../../layouts/Base.astro';
import { about } from '../../data/about';
import { paragraphs, inlineEmphasis } from '../../lib/text';
---

<Base
  title="About"
  description={`More than 50 years of jazz and commercial music at UNLV — degrees from bachelor's through the DMA, ${about.downbeatAwards} DownBeat Student Music Awards since 2010, and a faculty of working professionals.`}
>
  <h1>About the program</h1>

  {paragraphs(about.lede).map((text, i) => (
    <p class={i === 0 ? 'lede' : undefined} set:html={inlineEmphasis(text)} />
  ))}

  <h2>Degrees</h2>

  <ul class="degrees">
    {
      about.degrees.map((degree) => (
        <li>
          <span class="degree-level">{degree.level}</span>
          <span class="degree-programs">{degree.programs}</span>
        </li>
      ))
    }
  </ul>

  {paragraphs(about.curriculumNote).map((text) => <p set:html={inlineEmphasis(text)} />)}

  <h2>Recognition</h2>

  <p>
    <strong>
      {about.downbeatAwards} DownBeat Student Music Awards since 2010
    </strong>{' '}
    — <span set:html={inlineEmphasis(about.downbeatNote)} />
  </p>

  {paragraphs(about.otherRecognition).map((text) => <p set:html={inlineEmphasis(text)} />)}

  <h2>Where we've played</h2>

  {paragraphs(about.touringNote).map((text) => <p set:html={inlineEmphasis(text)} />)}

  <ul class="stages">
    {about.stages.map((stage) => <li>{stage}</li>)}
  </ul>

  <h2>Who our students work with</h2>

  {paragraphs(about.guestArtistsNote).map((text) => <p set:html={inlineEmphasis(text)} />)}

  {
    about.guestArtists.length > 0 && (
      <details>
        <summary>The full list of visiting artists and clinicians</summary>
        <ul class="names">
          {about.guestArtists.map((name) => <li>{name}</li>)}
        </ul>
      </details>
    )
  }

  {paragraphs(about.vegasNote).map((text) => <p set:html={inlineEmphasis(text)} />)}

  {
    about.vegasArtists.length > 0 && (
      <details>
        <summary>Artists our students have performed with in Las Vegas</summary>
        <ul class="names">
          {about.vegasArtists.map((name) => <li>{name}</li>)}
        </ul>
      </details>
    )
  }

  <h2>Where our alumni go</h2>

  {paragraphs(about.alumniNote).map((text) => <p set:html={inlineEmphasis(text)} />)}

  <ul class="names names-wide">
    {about.alumni.map((name) => <li>{name}</li>)}
  </ul>

  {paragraphs(about.alumniClosing).map((text) => <p set:html={inlineEmphasis(text)} />)}

  <section class="aside-note">
    <h2>Applying</h2>
    <p>
      Degree requirements, audition dates and admissions are handled by the UNLV
      School of Music. Everything you need is at{' '}
      <a href="https://www.unlv.edu/music">unlv.edu/music</a>.
    </p>
  </section>

  <style>
    .degrees {
      list-style: none;
      padding: 0;
      max-width: 46rem;
    }

    .degrees li {
      display: grid;
      gap: 0.1rem;
      padding: 0.7rem 0;
      border-bottom: 1px solid var(--rule);
    }

    .degree-level {
      font-weight: 600;
    }

    .degree-programs {
      color: var(--ink-soft);
      font-size: 0.95rem;
    }

    .stages {
      max-width: 46rem;
      padding-left: 1.2rem;
    }

    .stages li {
      margin-bottom: 0.3rem;
    }

    details {
      margin: 1rem 0 1.5rem;
      border: 1px solid var(--rule);
      border-radius: 6px;
      padding: 0.85rem 1rem;
      background: var(--panel);
    }

    summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--accent);
    }

    .names {
      list-style: none;
      padding: 0;
      margin: 1rem 0 0;
      columns: 16rem;
      column-gap: 2rem;
    }

    .names li {
      padding: 0.15rem 0;
      break-inside: avoid;
    }

    .names-wide {
      columns: 22rem;
      margin-top: 0.5rem;
    }

    .aside-note {
      margin-top: 3rem;
      padding: 1.25rem;
      background: var(--panel);
      border-radius: 6px;
    }

    .aside-note h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    .aside-note p {
      margin-bottom: 0;
      max-width: 46rem;
    }
  </style>
</Base>
