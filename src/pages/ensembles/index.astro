---
import Base from '../../layouts/Base.astro';
import { ensembles, namesFor } from '../../data/ensembles';
import { loadUpcomingEvents, formatEventDate } from '../../lib/events';

const upcoming = await loadUpcomingEvents();

/**
 * Each ensemble's own upcoming dates, matched on the exact ensemble name used in
 * the events Sheet. This is why the names in ensembles.ts must match the Sheet.
 */
const scheduleFor = (ensemble: (typeof ensembles)[number]) => {
  const names = namesFor(ensemble);
  return upcoming.filter((event) => event.ensembles.some((n) => names.includes(n)));
};

/**
 * Warn during the build if the Sheet references an ensemble this page doesn't
 * list. Those events silently vanish from ensemble pages otherwise. `npm run
 * check` is the hard version; this puts it in the Cloudflare build log too, so a
 * rename made in the CMS surfaces without anyone remembering to run anything.
 *
 * A warning, not a failure: a faculty member renaming an ensemble should never
 * be able to break the deploy by typing.
 */
const listed = new Set(ensembles.flatMap(namesFor));
const orphaned = [...new Set(upcoming.flatMap((e) => e.ensembles))].filter(
  (name) => !listed.has(name),
);
if (orphaned.length > 0) {
  console.warn(
    `\n  [content] ${orphaned.length} ensemble name(s) in the events Sheet are not on the Ensembles page:\n` +
      orphaned.map((n) => `    - "${n}"`).join('\n') +
      `\n  Their concerts will not appear on any ensemble page. Run \`npm run check\` for detail.\n`,
  );
}
---

<Base
  title="Ensembles"
  description="The eight active ensembles of the UNLV Jazz & Commercial Music area — big bands, vocal jazz, Latin jazz, contemporary jazz, and the Joe Williams Scholarship small groups."
>
  <h1>Ensembles</h1>

  <p class="lede">
    Eight ensembles perform across our concert season, on campus and throughout
    Las Vegas.
  </p>

  <div class="ensembles">
    {
      ensembles.map((ensemble) => {
        const dates = scheduleFor(ensemble);
        return (
          <section class="ensemble">
            {ensemble.photo?.src && (
              <img
                class="ensemble-photo"
                src={ensemble.photo.src}
                alt={ensemble.photo.alt}
                loading="lazy"
                decoding="async"
              />
            )}
            <h2>{ensemble.name}</h2>
            <p class="ensemble-directors">
              {ensemble.directors.length > 1 ? 'Directors' : 'Director'}:{' '}
              {ensemble.directors.join(' and ')}
            </p>
            <p class="ensemble-description">{ensemble.description}</p>

            {dates.length > 0 && (
              <p class="ensemble-dates">
                <strong>Coming up:</strong>{' '}
                {dates
                  .map((event) => `${formatEventDate(event.date)} at ${event.venue}`)
                  .join(' · ')}
              </p>
            )}
          </section>
        );
      })
    }
  </div>

  <section class="aside-note">
    <h2>Interested in playing with us?</h2>
    <p>
      Audition requirements, degree programs and admissions information are
      maintained by the UNLV School of Music at{' '}
      <a href="https://www.unlv.edu/music">unlv.edu/music</a>.
    </p>
  </section>

  <style>
    .ensembles {
      display: grid;
      gap: 1.75rem;
      margin-top: 2rem;
    }

    .ensemble {
      border-left: 3px solid var(--accent);
      padding-left: 1.1rem;
    }

    .ensemble-photo {
      display: block;
      width: 100%;
      height: auto;
      max-width: 34rem;
      border-radius: 6px;
      margin-bottom: 0.75rem;
    }

    .ensemble h2 {
      margin: 0 0 0.15rem;
      font-size: 1.25rem;
    }

    .ensemble-directors {
      margin: 0 0 0.5rem;
      font-size: 0.85rem;
      letter-spacing: 0.03em;
      text-transform: uppercase;
      color: var(--ink-soft);
    }

    .ensemble-description {
      margin: 0;
      max-width: 46rem;
    }

    .ensemble-dates {
      margin: 0.6rem 0 0;
      font-size: 0.95rem;
      color: var(--ink-soft);
    }

    .aside-note {
      margin-top: 3rem;
      padding: 1.25rem;
      background: var(--panel);
      border-radius: 6px;
    }

    .aside-note h2 {
      margin-top: 0;
      font-size: 1.1rem;
    }

    .aside-note p {
      margin-bottom: 0;
      max-width: 46rem;
    }
  </style>
</Base>
