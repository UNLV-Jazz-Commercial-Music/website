---
import Base from '../layouts/Base.astro';
import EventList from '../components/EventList.astro';
import { loadUpcomingEvents } from '../lib/events';

const upcoming = await loadUpcomingEvents(3);
---

<Base
  title="Home"
  description="Jazz and commercial music at the University of Nevada, Las Vegas — three big bands, ten combos, vocal, guitar, Latin and contemporary jazz ensembles."
>
  <h1>UNLV Jazz &amp; Commercial Music</h1>

  <p class="lede">
    Three big bands, ten combos, and vocal, guitar, Latin and contemporary jazz
    ensembles, performing across Las Vegas and beyond.
  </p>

  <h2>Upcoming performances</h2>

  <EventList
    events={upcoming}
    emptyMessage="Nothing on the calendar right now — check back soon."
  />

  {upcoming.length > 0 && <p><a href="/events">See all events</a></p>}
</Base>
